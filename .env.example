# TalentScreen AI Environment Configuration
# Supported providers: "mock" (offline default), "gemini", "openai"
DEFAULT_LLM_PROVIDER=mock

# Gemini API Key (optional - needed if DEFAULT_LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API Key (optional - needed if DEFAULT_LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Model overrides (optional)
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
PORT=3000
